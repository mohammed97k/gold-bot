import os
import requests
from datetime import datetime, timezone, timedelta

TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN", "8673315879:AAEPTIMUBtZu44zlSoumjDa8jJbVznGmEhE")
CHAT_ID = os.getenv("CHAT_ID", "1376555014")
API_KEY = os.getenv("API_KEY", "e12a2b0e02d4479094bd0e968e8b35e4")

IRAQ_TZ = timezone(timedelta(hours=3))

def get_iraq_time():
    return datetime.now(IRAQ_TZ)

def send_telegram(msg):
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": CHAT_ID, "text": msg, "parse_mode": "Markdown"}
    try:
        requests.post(url, json=payload, timeout=15)
    except Exception as e:
        print(f"Telegram error: {e}")

def check_symbol(symbol_name, symbol_code, decimals=2):
    try:
        now_iq = get_iraq_time()
        # إيقاف أثناء عطلة نهاية الأسبوع
        if now_iq.weekday() in [5, 6]:
            return False

        url = f"https://api.twelvedata.com/time_series?symbol={symbol_code}&interval=5min&outputsize=35&apikey={API_KEY}"
        data = requests.get(url, timeout=15).json()

        if "values" not in data:
            return False

        raw_candles = list(reversed(data["values"]))
        candles = []
        for c in raw_candles:
            candles.append({
                "datetime": c["datetime"],
                "open": float(c["open"]),
                "high": float(c["high"]),
                "low": float(c["low"]),
                "close": float(c["close"])
            })

        if len(candles) < 15:
            return False

        last_c = candles[-2]  # شمعة التأكيد المغلقة حديثاً

        # التأكد الصارم أن الشمعة حديثة جداً (خلال آخر 7 دقائق فقط) لمنع تكرار القديم
        candle_time = datetime.strptime(last_c["datetime"], "%Y-%m-%d %H:%M:%S").replace(tzinfo=timezone.utc)
        candle_time_iq = candle_time.astimezone(IRAQ_TZ)
        time_diff = (now_iq - candle_time_iq).total_seconds() / 60
        if time_diff > 7 or time_diff < 0:
            return False

        price_now = candles[-1]["close"]
        is_gold = (price_now > 1000 and price_now < 8000) or ("XAU" in symbol_code)
        is_index = (price_now >= 8000) or ("DJI" in symbol_code) or ("IXIC" in symbol_code)

        sl_pts = 10.0 if is_gold else (100.0 if is_index else 0.0015)
        tp_pts = 25.0 if is_gold else (250.0 if is_index else 0.0030)
        be_trigger = sl_pts * 0.7

        # بناء قمم A وقيعان V بفلتر ارتدادي صلب (3 شموع) لمنع الفوضى
        res_level = None
        sup_level = None

        for i in range(len(candles) - 4, 3, -1):
            body_high = max(candles[i]["open"], candles[i]["close"])
            if (body_high > max(candles[i-1]["open"], candles[i-1]["close"]) and 
                body_high > max(candles[i-2]["open"], candles[i-2]["close"]) and
                body_high > max(candles[i+1]["open"], candles[i+1]["close"])):
                res_level = body_high
                break

        for i in range(len(candles) - 4, 3, -1):
            body_low = min(candles[i]["open"], candles[i]["close"])
            if (body_low < min(candles[i-1]["open"], candles[i-1]["close"]) and 
                body_low < min(candles[i-2]["open"], candles[i-2]["close"]) and
                body_low < min(candles[i+1]["open"], candles[i+1]["close"])):
                sup_level = body_low
                break

        # شروط الرفض وتأكيد الشمعة
        buy_trigger = (sup_level is not None) and (last_c["low"] <= sup_level) and (last_c["close"] > sup_level) and (last_c["close"] > last_c["open"])
        sell_trigger = (res_level is not None) and (last_c["high"] >= res_level) and (last_c["close"] < res_level) and (last_c["close"] < last_c["open"])

        formatted_time = candle_time_iq.strftime("%I:%M %p")

        if buy_trigger:
            entry = last_c["close"]
            sl = entry - sl_pts
            tp = entry + tp_pts
            be_val = entry + be_trigger

            send_telegram(
                f"🟢 *إشارة شراء مؤكدة - {symbol_name}*\n"
                f"───────────────\n"
                f"📌 سعر الدخول: `{entry:.{decimals}f}`\n"
                f"🛑 وقف الخسارة: `{sl:.{decimals}f}`\n"
                f"🛡️ نقطة التأمين: `{be_val:.{decimals}f}`\n"
                f"🎯 الهدف (+250 نقطة): `{tp:.{decimals}f}`\n"
                f"⏰ الفريم: 5 دقائق\n"
                f"⏱ التوقيت (العراق): `{formatted_time}`"
            )
            return True

        elif sell_trigger:
            entry = last_c["close"]
            sl = entry + sl_pts
            tp = entry - tp_pts
            be_val = entry - be_trigger

            send_telegram(
                f"🔴 *إشارة بيع مؤكدة - {symbol_name}*\n"
                f"───────────────\n"
                f"📌 سعر الدخول: `{entry:.{decimals}f}`\n"
                f"🛑 وقف الخسارة: `{sl:.{decimals}f}`\n"
                f"🛡️ نقطة التأمين: `{be_val:.{decimals}f}`\n"
                f"🎯 الهدف (+250 نقطة): `{tp:.{decimals}f}`\n"
                f"⏰ الفريم: 5 دقائق\n"
                f"⏱ التوقيت (العراق): `{formatted_time}`"
            )
            return True

        return False

    except Exception as e:
        print(f"Error checking {symbol_name}: {e}")
        return False

def main():
    symbols = [
        ("الذهب (XAU/USD)", "XAU/USD", 2),
        ("داو جونز (US30)", "DJI", 2),
        ("ناسداك (NAS100)", "IXIC", 2),
        ("الباوند (GBP/USD)", "GBP/USD", 5),
        ("اليورو (EUR/USD)", "EUR/USD", 5)
    ]
    
    for s_name, s_code, dec in symbols:
        triggered = check_symbol(s_name, s_code, dec)
        if triggered:
            break

if __name__ == "__main__":
    main()
