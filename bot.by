import os
import requests
from datetime import datetime, timezone, timedelta

TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN", "8673315879:AAEPTIMUBtZu44zlSoumjDa8jJbVznGmEhE")
CHAT_ID = os.getenv("CHAT_ID", "1376555014")
API_KEY = os.getenv("API_KEY", "e12a2b0e02d4479094bd0e968e8b35e4")

# توقيت العراق (UTC+3)
IRAQ_TZ = timezone(timedelta(hours=3))

def get_iraq_time():
    now = datetime.now(IRAQ_TZ)
    return now.strftime("%I:%M:%S %p")

def send_telegram(msg):
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": CHAT_ID, "text": msg, "parse_mode": "Markdown"}
    try:
        requests.post(url, json=payload, timeout=15)
    except Exception as e:
        print(f"Telegram error: {e}")

def check_symbol(symbol_name, symbol_code, decimals=2):
    try:
        url = f"https://api.twelvedata.com/time_series?symbol={symbol_code}&interval=5min&outputsize=30&apikey={API_KEY}"
        data = requests.get(url, timeout=15).json()

        if "values" not in data:
            return

        raw_candles = list(reversed(data["values"]))
        candles = []
        for c in raw_candles:
            candles.append({
                "open": float(c["open"]),
                "high": float(c["high"]),
                "low": float(c["low"]),
                "close": float(c["close"])
            })

        if len(candles) < 10:
            return

        # قياس النقاط والأصل تماماً مثل تريدنج فيو
        price_now = candles[-1]["close"]
        is_gold = (price_now > 1000 and price_now < 8000) or ("XAU" in symbol_code)
        is_index = (price_now >= 8000) or ("DJI" in symbol_code) or ("IXIC" in symbol_code)

        sl_pts = 10.0 if is_gold else (100.0 if is_index else 0.0020)
        tp_pts = 25.0 if is_gold else (250.0 if is_index else 0.0050)

        last_c = candles[-2]
        prev_3_c = candles[-5]

        # مستويات A و V الكلاسيكية
        res_level = prev_3_c["close"] if prev_3_c["high"] == max([c["high"] for c in candles[-8:-2]]) else candles[-5]["close"]
        sup_level = prev_3_c["close"] if prev_3_c["low"] == min([c["low"] for c in candles[-8:-2]]) else candles[-5]["close"]

        # شروط الدخول المنضبطة
        buy_trigger  = (last_c["low"] <= sup_level) and (last_c["close"] > sup_level) and (last_c["close"] > last_c["open"])
        sell_trigger = (last_c["high"] >= res_level) and (last_c["close"] < res_level) and (last_c["close"] < last_c["open"])

        current_time_iq = get_iraq_time()

        if buy_trigger:
            entry = last_c["close"]
            sl = entry - sl_pts
            tp = entry + tp_pts
            be_val = entry + sl_pts
            
            # 1. إشعار الدخول وتفاصيل الصفقة
            send_telegram(
                f"🟢 *MSNR BUY - {symbol_name}*\n\n"
                f"📌 دخول: `{entry:.{decimals}f}`\n"
                f"🛑 ستوب: `{sl:.{decimals}f}`\n"
                f"🛡️ تأمين: `{be_val:.{decimals}f}`\n"
                f"🎯 هدف: `{tp:.{decimals}f}`\n"
                f"⏰ الفريم: 5 دقائق\n"
                f"⏱ التوقيت (العراق): `{current_time_iq}`"
            )
            
            # مراقبة سريعة للهدف والستوب والتأمين
            current_price = candles[-1]["close"]
            if current_price >= be_val:
                send_telegram(f"🛡️ *تم تأمين الصفقة (BE)* للأصل `{symbol_name}` عند تجاوز نقطة التأمين.")
            if current_price >= tp:
                send_telegram(f"🎯 *تم تحقيق الهدف (TP)* بنجاح للأصل `{symbol_name}`! 🔥")
            elif current_price <= sl:
                send_telegram(f"🛑 *تم ضرب الستوب (SL)* للأصل `{symbol_name}`.")

        elif sell_trigger:
            entry = last_c["close"]
            sl = entry + sl_pts
            tp = entry - tp_pts
            be_val = entry - sl_pts
            
            # 1. إشعار الدخول وتفاصيل الصفقة
            send_telegram(
                f"🔴 *MSNR SELL - {symbol_name}*\n\n"
                f"📌 دخول: `{entry:.{decimals}f}`\n"
                f"🛑 ستوب: `{sl:.{decimals}f}`\n"
                f"🛡️ تأمين: `{be_val:.{decimals}f}`\n"
                f"🎯 هدف: `{tp:.{decimals}f}`\n"
                f"⏰ الفريم: 5 دقائق\n"
                f"⏱ التوقيت (العراق): `{current_time_iq}`"
            )
            
            # مراقبة سريعة للهدف والستوب والتأمين
            current_price = candles[-1]["close"]
            if current_price <= be_val:
                send_telegram(f"🛡️ *تم تأمين الصفقة (BE)* للأصل `{symbol_name}` عند تجاوز نقطة التأمين.")
            if current_price <= tp:
                send_telegram(f"🎯 *تم تحقيق الهدف (TP)* بنجاح للأصل `{symbol_name}`! 🔥")
            elif current_price >= sl:
                send_telegram(f"🛑 *تم ضرب الستوب (SL)* للأصل `{symbol_name}`.")

    except Exception as e:
        print(f"Error checking {symbol_name}: {e}")

def main():
    check_symbol("الذهب (XAU/USD)", "XAU/USD", decimals=2)
    check_symbol("داو جونز (US30)", "DJI", decimals=2)
    check_symbol("ناسداك (NAS100)", "IXIC", decimals=2)
    check_symbol("الباوند (GBP/USD)", "GBP/USD", decimals=5)
    check_symbol("اليورو (EUR/USD)", "EUR/USD", decimals=5)

if __name__ == "__main__":
    main()
