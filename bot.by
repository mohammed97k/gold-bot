import os
import requests
import yfinance as yf
import pandas as pd
import numpy as np

# إعدادات تيليجرام (يمكن وضعها كـ Secrets في GitHub أو كتابتها مباشرة)
TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "YOUR_BOT_TOKEN_HERE")
TELEGRAM_CHAT_ID = os.getenv("TELEGRAM_CHAT_ID", "YOUR_CHAT_ID_HERE")

def send_telegram_alert(message: str):
    if TELEGRAM_BOT_TOKEN == "YOUR_BOT_TOKEN_HERE" or not TELEGRAM_BOT_TOKEN:
        print("[!] لم يتم ضبط توكن التيليجرام. طباعة الرسالة محلياً:")
        print(message)
        return
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": message,
        "parse_mode": "HTML"
    }
    try:
        res = requests.post(url, json=payload, timeout=10)
        if res.status_code == 200:
            print("[✓] تم إرسال التنبيه إلى تيليجرام بنجاح.")
        else:
            print(f"[!] خطأ في إرسال تيليجرام: {res.text}")
    except Exception as e:
        print(f"[!] استثناء أثناء الإرسال: {e}")

def run_macro_strategy():
    print("[*] جاري سحب بيانات الذهب وفحص نموذج الـ Macro Swing (4H + 1H)...")
    
    # سحب بيانات الساعة
    df_raw = yf.download("GC=F", period="2mo", interval="1h", progress=False)
    if df_raw.empty:
        df_raw = yf.download("XAUUSD=X", period="2mo", interval="1h", progress=False)

    if isinstance(df_raw.columns, pd.MultiIndex):
        df_raw.columns = df_raw.columns.get_level_values(0)
    df_raw = df_raw.dropna()

    # توحيد التوقيت لبغداد
    if df_raw.index.tz is None:
        df_raw.index = df_raw.index.tz_localize("UTC").tz_convert("Asia/Baghdad")
    else:
        df_raw.index = df_raw.index.tz_convert("Asia/Baghdad")

    # 1. بناء هيكل فريم الـ 4 ساعات
    df_4h = df_raw.resample('4h').agg({
        'Open': 'first',
        'High': 'max',
        'Low': 'min',
        'Close': 'last'
    }).dropna()

    lookback_4h = 18
    h4_high = df_4h['High'].rolling(lookback_4h).max().iloc[-2] # القمة السابقة المحمية
    h4_low = df_4h['Low'].rolling(lookback_4h).min().iloc[-2]   # القاع السابق المحمي

    # 2. فحص آخر شمعة مكتملة على فريم الساعة (1H)
    last_1h = df_raw.iloc[-2]
    c_open, c_close = last_1h['Open'], last_1h['Close']
    c_high, c_low = last_1h['High'], last_1h['Low']
    c_range = c_high - c_low if (c_high - c_low) > 0 else 0.1
    c_time = last_1h.name.strftime('%Y-%m-%d %H:%M')

    upper_wick = c_high - max(c_open, c_close)
    lower_wick = min(c_open, c_close) - c_low

    rr = 2.0
    signal = None

    # شرط الشراء المؤسسي (ارتداد ورفض من قاع 4H)
    if (c_low <= h4_low + 1.5) and (lower_wick / c_range >= 0.38) and (c_close > c_open):
        entry = c_close
        sl = c_low - 1.2
        risk = entry - sl
        if 6.0 <= risk <= 13.0: # نطاق الستوب: 60 إلى 130 نقطة
            tp = entry + (risk * rr)
            signal = {
                "type": "BUY 🟢",
                "entry": entry,
                "sl": sl,
                "tp": tp,
                "risk_pips": int(risk * 10),
                "reward_pips": int((tp - entry) * 10),
                "time": c_time
            }

    # شرط البيع المؤسسي (ارتداد ورفض من قمة 4H)
    elif (c_high >= h4_high - 1.5) and (upper_wick / c_range >= 0.38) and (c_close < c_open):
        entry = c_close
        sl = c_high + 1.2
        risk = sl - entry
        if 6.0 <= risk <= 13.0: # نطاق الستوب: 60 إلى 130 نقطة
            tp = entry - (risk * rr)
            signal = {
                "type": "SELL 🔴",
                "entry": entry,
                "sl": sl,
                "tp": tp,
                "risk_pips": int(risk * 10),
                "reward_pips": int((entry - tp) * 10),
                "time": c_time
            }

    if signal:
        msg = (
            f"🔔 <b>إشارة تداول جديدة: الذهب (XAU/USD)</b>\n"
            f"━━━━━━━━━━━━━━━━━━\n"
            f"📌 <b>النوع:</b> {signal['type']}\n"
            f"💵 <b>سعر الدخول:</b> {signal['entry']:.2f}\n"
            f"🛑 <b>وقف الخسارة (SL):</b> {signal['sl']:.2f} ({signal['risk_pips']} نقطة)\n"
            f"🎯 <b>الهدف (TP):</b> {signal['tp']:.2f} ({signal['reward_pips']} نقطة)\n"
            f"⚖️ <b>نسبة العائد للمخاطرة:</b> 1:2\n"
            f"🕒 <b>توقيت الشمعة:</b> {signal['time']} بتوقيت بغداد\n"
            f"━━━━━━━━━━━━━━━━━━\n"
            f"🛡️ <i>النموذج: Macro Swing (4H Level + 1H Wick Rejection)</i>"
        )
        send_telegram_alert(msg)
    else:
        print("[i] لا توجد فرصة مطابقة لشروط الـ Macro Swing في الشمعة الأخيرة.")

if __name__ == "__main__":
    run_macro_strategy()
