import requests

TELEGRAM_TOKEN = "8673315879:AAEPTIMUBtZu44zlSoumjDa8jJbVznGmEhE"
CHAT_ID = "1376555014"

def send_telegram(msg):
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": CHAT_ID, "text": msg, "parse_mode": "Markdown"}
    try:
        requests.post(url, json=payload, timeout=10)
    except:
        pass

def main():
    try:
        # جلب شموع وسعر الذهب الفوري الحقيقي XAUUSD من خادم TradingView/Investing المباشر
        headers = {"User-Agent": "Mozilla/5.0"}
        url = "https://api.investing.com/api/financialdata/68/historical/chart/?interval=PT1H&pointscounter=30"
        
        # بديل فوري ومضمون لبيانات الفوركس اللحظية
        f_url = "https://financialmodelingprep.com/api/v3/historical-chart/1hour/XAUUSD?apikey=demo"
        res = requests.get(f_url, timeout=10).json()

        candles = []
        if isinstance(res, list) and len(res) >= 15:
            # ترتيب البيانات من الأقدم للأحدث
            for item in reversed(res[:25]):
                candles.append({
                    "open": float(item["open"]),
                    "high": float(item["high"]),
                    "low": float(item["low"]),
                    "close": float(item["close"])
                })
        else:
            # سيرفر احتياطي مجاني لحظي لأسعار XAUUSD الفورية
            tv_url = "https://scanner.tradingview.com/forex/scan"
            tv_data = {"symbols": {"tickers": ["OANDA:XAUUSD"]}, "columns": ["close", "open", "high", "low"]}
            tv_res = requests.post(tv_url, json=tv_data, headers=headers, timeout=10).json()
            p = float(tv_res['data'][0]['d'][0])
            send_telegram(f"🟢 *تم فحص السوق بنجاح*\nسعر الذهب الفوري (XAUUSD): `{p:.2f}`\nجاري متابعة الشروط...")
            return

        current_price = candles[-1]["close"]
        send_telegram(f"🟢 *تم فحص الذهب الفوري XAUUSD*\nالسعر الحالي: `{current_price:.2f}`\nجاري مراقبة نماذج ICT و MSNR...")

        # ================= ICT Model =================
        recent_highs = [c["high"] for c in candles[-10:-2]]
        recent_lows  = [c["low"] for c in candles[-10:-2]]
        bsl = max(recent_highs)
        ssl = min(recent_lows)

        last_c = candles[-2]
        prev_c = candles[-3]

        body = abs(last_c["close"] - last_c["open"])
        c_range = last_c["high"] - last_c["low"]
        displacement = (body / c_range > 0.6) if c_range > 0 else False

        if prev_c["low"] < ssl and last_c["close"] > bsl and displacement:
            sl = prev_c["low"]
            tp = last_c["close"] + ((last_c["close"] - sl) * 2.5)
            send_telegram(f"🚨 *إشارة شراء ICT - الذهب*\n\n📌 الدخول: `{last_c['close']:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`\n⏰ الفريم: 1 ساعة")

        elif prev_c["high"] > bsl and last_c["close"] < ssl and displacement:
            sl = prev_c["high"]
            tp = last_c["close"] - ((sl - last_c["close"]) * 2.5)
            send_telegram(f"🚨 *إشارة بيع ICT - الذهب*\n\n📌 الدخول: `{last_c['close']:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`\n⏰ الفريم: 1 ساعة")

        # ================= MSNR Model =================
        snr_highs = [c["high"] for c in candles[-15:-2]]
        snr_lows  = [c["low"] for c in candles[-15:-2]]
        resistance = max(snr_highs)
        support    = min(snr_lows)

        if prev_c["close"] < support and last_c["high"] >= support and last_c["close"] < support:
            sl = last_c["high"] + 1.5
            tp = last_c["close"] - ((sl - last_c["close"]) * 2.0)
            send_telegram(f"🎯 *إشارة قناص MSNR (بيع ذهب)*\n\n📌 الدخول: `{last_c['close']:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`")

        elif prev_c["close"] > resistance and last_c["low"] <= resistance and last_c["close"] > resistance:
            sl = last_c["low"] - 1.5
            tp = last_c["close"] + ((last_c["close"] - sl) * 2.0)
            send_telegram(f"🎯 *إشارة قناص MSNR (شراء ذهب)*\n\n📌 الدخول: `{last_c['close']:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`")

    except Exception as e:
        send_telegram(f"⚠️ تنبيه: {e}")

if __name__ == "__main__":
    main()
