import requests

TELEGRAM_TOKEN = "8673315879:AAEPTIMUBtZu44zlSoumjDa8jJbVznGmEhE"
CHAT_ID = "1376555014"
API_KEY = "e12a2b0e02d4479094bd0e968e8b35e4"

def send_telegram(msg):
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": CHAT_ID, "text": msg, "parse_mode": "Markdown"}
    try:
        requests.post(url, json=payload, timeout=15)
    except Exception as e:
        print(f"Telegram error: {e}")

def main():
    try:
        # جلب الشموع من Twelve Data
        url = f"https://api.twelvedata.com/time_series?symbol=XAU/USD&interval=1h&outputsize=25&apikey={API_KEY}"
        data = requests.get(url, timeout=15).json()

        if "values" not in data:
            send_telegram(f"⚠️ خطأ: {data.get('message', 'تأكد من المفتاح')}")
            return

        raw_candles = list(reversed(data["values"]))
        candles = []
        for c in raw_candles:
            candles.append({
                "open": float(c["open"]),
                "high": float(c["high"]),
                "low": float(c["low"]),
                "close": float(c["close"])
            })

        current_price = candles[-1]["close"]
        send_telegram(f"🟢 *تم فحص الذهب الفوري بنجاح*\nالسعر اللحظي (XAU/USD): `{current_price:.2f}`\nجاري مراقبة الصفقات...")

        # نفس إعدادات مؤشرك تماماً (Corrected 5 2)
        lookback = 5
        rr = 2.0

        # فحص الشمعة المنتهية مؤخراً
        last_c = candles[-2]
        prev_c = candles[-3]

        # حساب القمم والقيعان لآخر 5 شموع تسبق الشمعة المنتهية
        recent = candles[-(lookback + 2):-2]
        highest_high = max([c["high"] for c in recent])
        lowest_low   = min([c["low"] for c in recent])

        # شرط بيع ICT المطابق للشارت تماماً
        ict_sell = (last_c["high"] > highest_high) and (last_c["close"] < last_c["open"]) and (last_c["close"] < prev_c["high"])

        # شرط شراء ICT المطابق للشارت تماماً
        ict_buy  = (last_c["low"] < lowest_low) and (last_c["close"] > last_c["open"]) and (last_c["close"] > prev_c["low"])

        if ict_sell:
            entry = last_c["close"]
            sl = last_c["high"] + 1.0
            tp = entry - ((sl - entry) * rr)
            send_telegram(f"🔴 *ICT SELL - الذهب*\n\n📌 الدخول: `{entry:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`\n⏰ الفريم: 1 ساعة")

        elif ict_buy:
            entry = last_c["close"]
            sl = last_c["low"] - 1.0
            tp = entry + ((entry - sl) * rr)
            send_telegram(f"🟢 *ICT BUY - الذهب*\n\n📌 الدخول: `{entry:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`\n⏰ الفريم: 1 ساعة")

    except Exception as e:
        send_telegram(f"⚠️ خطأ أثناء الفحص: {e}")

if __name__ == "__main__":
    main()
