import requests

TELEGRAM_TOKEN = "8673315879:AAEPTIMUBtZu44zlSoumjDa8jJbVznGmEhE"
CHAT_ID = "1376555014"
API_KEY = "e12a2b0e02d4479094bd0e968e8b35e4"

def send_telegram(msg):
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": CHAT_ID, "text": msg, "parse_mode": "Markdown"}
    try:
        requests.post(url, json=payload, timeout=15)
    except Exception as e:
        print(f"Telegram error: {e}")

def main():
    try:
        # فريم 5 دقائق للذهب
        url = f"https://api.twelvedata.com/time_series?symbol=XAU/USD&interval=5min&outputsize=30&apikey={API_KEY}"
        data = requests.get(url, timeout=15).json()

        if "values" not in data:
            return

        raw_candles = list(reversed(data["values"]))
        candles = []
        for c in raw_candles:
            candles.append({
                "open": float(c["open"]),
                "high": float(c["high"]),
                "low": float(c["low"]),
                "close": float(c["close"])
            })

        lookback = 5
        rr = 2.0

        # الشمعة المغلقة المنتهية هي candles[-2]
        last_c = candles[-2]
        prev_c = candles[-3]

        # قمم وقيعان الـ 5 شموع السابقة للشمعة المنتهية
        recent = candles[-7:-2]
        highest_high = max([c["high"] for c in recent])
        lowest_low   = min([c["low"] for c in recent])

        # مستويات SNR (دعم ومقاومة لآخر 10 شموع)
        recent_10 = candles[-12:-2]
        snr_res = max([c["high"] for c in recent_10])
        snr_sup = min([c["low"] for c in recent_10])

        # 1. شروط ICT
        ict_sell = (last_c["high"] > highest_high) and (last_c["close"] < last_c["open"]) and (last_c["close"] < prev_c["high"])
        ict_buy  = (last_c["low"] < lowest_low) and (last_c["close"] > last_c["open"]) and (last_c["close"] > prev_c["low"])

        # 2. شروط SNR
        snr_sell = (last_c["high"] >= snr_res) and (last_c["close"] < snr_res) and (last_c["close"] < last_c["open"])
        snr_buy  = (last_c["low"] <= snr_sup) and (last_c["close"] > snr_sup) and (last_c["close"] > last_c["open"])

        # معالجة إشارات البيع
        if ict_sell:
            entry = last_c["close"]
            sl = last_c["high"]
            tp = entry - ((sl - entry) * rr)
            send_telegram(f"🔴 *إشارة ICT SELL (5M)*\n\n📌 الدخول: `{entry:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`")
        elif snr_sell:
            entry = last_c["close"]
            sl = last_c["high"]
            tp = entry - ((sl - entry) * rr)
            send_telegram(f"🔻 *إشارة SNR SELL (5M)*\n\n📌 الدخول: `{entry:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`")

        # معالجة إشارات الشراء
        if ict_buy:
            entry = last_c["close"]
            sl = last_c["low"]
            tp = entry + ((entry - sl) * rr)
            send_telegram(f"🟢 *إشارة ICT BUY (5M)*\n\n📌 الدخول: `{entry:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`")
        elif snr_buy:
            entry = last_c["close"]
            sl = last_c["low"]
            tp = entry + ((entry - sl) * rr)
            send_telegram(f"🔺 *إشارة SNR BUY (5M)*\n\n📌 الدخول: `{entry:.2f}`\n🛑 الستوب: `{sl:.2f}`\n🎯 الهدف: `{tp:.2f}`")

    except Exception as e:
        pass

if __name__ == "__main__":
    main()
